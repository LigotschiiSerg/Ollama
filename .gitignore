@'
# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# SQLite
db.sqlite3
db.sqlite3-*
*.sqlite3
*.db

# Uploaded documents
media/
uploads/
*.pdf

# Secrets
.env
.env.*
!.env.example
secrets.json
credentials.json
*.pem
*.key

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# Cache
.pytest_cache/
.coverage
htmlcov/

# AI models
*.gguf
*.safetensors
*.pt
*.pth
models/

# Temporary files
.DS_Store
Thumbs.db
'@ | Set-Content -Path ".gitignore" -Encoding utf8